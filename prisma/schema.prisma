generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                         String                      @id @default(uuid())
  name                       String
  slug                       String                      @unique
  status                     TenantStatus                @default(TRIAL)
  trialExpiresAt             DateTime?
  gracePeriodEndsAt          DateTime?
  suspendedAt                DateTime?
  sessionVersion             Int                         @default(0)
  ownerEmail                 String?
  ownerName                  String?
  billingEmail               String?
  seatCount                  Int                         @default(0)
  lastActivityAt             DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  attendanceRecords          AttendanceRecord[]
  contacts                   Contact[]
  deals                      Deal[]
  departments                Department[]
  expenses                   Expense[]
  inventoryItems             InventoryItem[]
  invoices                   Invoice[]
  notifications              Notification[]
  payments                   Payment[]
  projects                   Project[]
  projectFiles               ProjectFile[]
  projectMembers             ProjectMember[]
  quickActions               QuickAction[]
  supportTickets             SupportTicket[]
  tasks                      Task[]
  blacklistedTokens          BlacklistedToken[]
  modules                    Module[]
  permissionGroups           PermissionGroup[]
  permissionGroupItems       PermissionGroupItem[]
  permissionGroupAssignments PermissionGroupAssignment[]
  permissionOverrides        PermissionOverride[]
  teamMembers                TeamMember[]
  teams                      Team[]
  users                      User[]
  roles                      Role[]
  invitations                Invitation[]
  lifecycleEvents            TenantLifecycleEvent[]
  documents                  Document[]
  formSubmissions            FormSubmission[]
  auditLogs                  AuditLog[]

  @@map("tenants")
}

model User {
  id                         String                      @id @default(uuid())
  email                      String
  password                   String
  name                       String
  roleId                     String
  role                       Role                        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  avatarUrl                  String?
  lastLoginAt                DateTime?
  sessionVersion             Int                         @default(0)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  isVerified                 Boolean                     @default(false)
  verifyTokenHash            String?
  verifyExpiresAt            DateTime?
  resetTokenHash             String?
  resetExpiresAt             DateTime?
  departmentId               String?                     @map("department")
  status                     EmploymentStatus            @default(ACTIVE)
  tenantId                   String
  attendanceRecords          AttendanceRecord[]
  contacts                   Contact[]
  assignedDeals              Deal[]                      @relation("DealAssignedTo")
  managedDepartment          Department?                 @relation("DepartmentManager")
  expenses                   Expense[]
  notifications              Notification[]
  projects                   Project[]
  uploadedFiles              ProjectFile[]
  projectMemberships         ProjectMember[]
  assignedTickets            SupportTicket[]             @relation("UserTickets")
  tasks                      Task[]
  blacklistedTokens          BlacklistedToken[]
  permissionGroupAssignments PermissionGroupAssignment[]
  permissionOverrides        PermissionOverride[]
  teamMemberships            TeamMember[]
  ledTeams                   Team[]                      @relation("TeamLead")
  department                 Department?                 @relation("DepartmentMembers", fields: [departmentId], references: [id])
  tenant                     Tenant                      @relation(fields: [tenantId], references: [id])
  invitationsSent            Invitation[]                @relation("InvitationsSent")
  invitationsAccepted        Invitation[]                @relation("InvitationsAccepted")
  documentsCreated           Document[]                  @relation("DocumentCreatedBy")
  documentsUpdated           Document[]                  @relation("DocumentUpdatedBy")
  formSubmissions            FormSubmission[]
  auditLogs                  AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, roleId])
  @@index([tenantId, departmentId])
  @@map("users")
}

model Contact {
  id             String          @id @default(uuid())
  firstName      String
  lastName       String
  email          String?
  phone          String?
  company        String?
  jobTitle       String?
  notes          String?
  status         String          @default("Lead")
  userId         String
  tenantId       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tags           String[]
  customFields   Json            @default("{}")
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  createdBy      User            @relation(fields: [userId], references: [id])
  deals          Deal[]
  invoices       Invoice[]
  supportTickets SupportTicket[]

  @@index([tenantId])
}

model Project {
  id          String          @id @default(uuid())
  name        String
  description String?
  status      String          @default("Planning")
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  priority    Int             @default(1)
  userId      String
  tenantId    String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  createdBy   User            @relation(fields: [userId], references: [id])
  files       ProjectFile[]
  teamMembers ProjectMember[]
  tasks       Task[]

  @@index([tenantId])
}

model Task {
  id           String    @id @default(uuid())
  title        String
  description  String?
  status       String    @default("Todo")
  priority     Int       @default(1)
  dueDate      DateTime?
  customFields Json      @default("{}")
  projectId    String
  assignedToId String
  tenantId     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  assignedTo   User      @relation(fields: [assignedToId], references: [id])
  project      Project   @relation(fields: [projectId], references: [id])
  tenant       Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Department {
  id                         String                      @id @default(uuid())
  name                       String
  key                        String
  description                String?
  isSystem                   Boolean                     @default(false)
  sortOrder                  Int                         @default(0)
  managerId                  String?                     @unique
  tenantId                   String
  createdAt                  DateTime                    @default(now())
  manager                    User?                       @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  tenant                     Tenant                      @relation(fields: [tenantId], references: [id])
  expenses                   Expense[]
  Module                     Module[]
  permissionGroupAssignments PermissionGroupAssignment[]
  teams                      Team[]
  members                    User[]                      @relation("DepartmentMembers")
  invitations                Invitation[]
  documents                  Document[]
  auditLogs                  AuditLog[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([tenantId, sortOrder])
}

model InventoryItem {
  id           String   @id @default(uuid())
  name         String
  description  String?
  sku          String?
  quantity     Int      @default(0)
  unit         String   @default("pcs")
  minStock     Int      @default(5)
  location     String?
  customFields Json     @default("{}")
  tenantId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, sku])
  @@index([tenantId])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  read      Boolean  @default(false)
  type      String
  userId    String
  tenantId  String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
}

model ProjectFile {
  id         String   @id @default(uuid())
  name       String
  url        String
  size       Int
  type       String
  projectId  String
  userId     String
  tenantId   String
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id])
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  uploadedBy User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   @default("Member")
  tenantId  String
  joinedAt  DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
}

model BlacklistedToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  tenantId  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tenantId])
  @@map("blacklisted_tokens")
}

model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String
  customerId    String
  amount        Float
  status        String    @default("Pending")
  dueDate       DateTime
  paidDate      DateTime?
  customFields  Json      @default("{}")
  tenantId      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  customer      Contact   @relation(fields: [customerId], references: [id])
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  payments      Payment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
}

model Payment {
  id        String   @id @default(uuid())
  invoiceId String
  amount    Float
  paidAt    DateTime @default(now())
  method    String
  tenantId  String
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Expense {
  id           String     @id @default(uuid())
  description  String
  amount       Float
  category     String
  incurredAt   DateTime
  customFields Json       @default("{}")
  departmentId String
  userId       String
  tenantId     String
  createdAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id])
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  createdBy    User       @relation(fields: [userId], references: [id])

  @@index([tenantId])
}

model Deal {
  id           String     @id @default(uuid())
  name         String
  contactId    String
  amount       Float
  status       DealStatus @default(LEAD)
  closeDate    DateTime?
  customFields Json       @default("{}")
  userId       String
  tenantId     String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  contact      Contact    @relation(fields: [contactId], references: [id])
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  assignedTo   User       @relation("DealAssignedTo", fields: [userId], references: [id])

  @@index([tenantId])
}

model SupportTicket {
  id             String       @id @default(uuid())
  subject        String
  description    String?
  status         TicketStatus @default(OPEN)
  priority       Int          @default(1)
  contactId      String
  userId         String?
  tenantId       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  resolvedAt     DateTime?
  slaDueDate     DateTime?
  customerRating Int?
  customFields   Json         @default("{}")
  createdBy      Contact      @relation(fields: [contactId], references: [id])
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  assignedTo     User?        @relation("UserTickets", fields: [userId], references: [id])

  @@index([tenantId])
}

model AttendanceRecord {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime
  status    String
  tenantId  String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
}

model QuickAction {
  id          String   @id @default(uuid())
  name        String
  description String?
  command     String
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Document {
  id           String         @id @default(uuid())
  tenantId     String
  departmentId String?
  moduleId     String?
  title        String
  slug         String
  format       DocumentFormat @default(MARKDOWN)
  status       DocumentStatus @default(DRAFT)
  category     String?
  content      String         @db.Text
  version      Int            @default(1)
  createdById  String
  updatedById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  module     Module?     @relation(fields: [moduleId], references: [id])
  createdBy  User        @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  updatedBy  User?       @relation("DocumentUpdatedBy", fields: [updatedById], references: [id])

  @@unique([tenantId, slug])
  @@index([tenantId, moduleId])
  @@index([tenantId, departmentId])
  @@map("documents")
}

model FormSubmission {
  id            String   @id @default(uuid())
  tenantId      String
  moduleId      String
  entityId      String?
  submittedById String?
  data          Json
  status        String   @default("SUBMITTED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id])
  module      Module @relation(fields: [moduleId], references: [id])
  submittedBy User?  @relation(fields: [submittedById], references: [id])

  @@index([tenantId, moduleId])
  @@index([tenantId, submittedById])
  @@map("form_submissions")
}

model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String
  departmentId String?
  actorId      String?
  action       String
  entity       String
  entityId     String?
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@index([tenantId, departmentId])
  @@map("audit_logs")
}

model Permission {
  id                    Int                    @id @default(autoincrement())
  type                  PermissionType         @unique
  permissionGroupItems  PermissionGroupItem[]
  permissionOverrides   PermissionOverride[]
  roleModulePermissions RoleModulePermission[]

  @@map("permissions")
}

model Module {
  id                    String                 @id @default(uuid())
  name                  String
  key                   String
  path                  String
  icon                  String?
  group                 String                 @default("Workspace")
  order                 Int                    @default(0)
  isNavigable           Boolean                @default(false)
  description           String?
  type                  ModuleType             @default(DATA_TABLE)
  targetEntity          String?
  config                Json                   @default("{}")
  dataScope             RoleDataScope?
  isActive              Boolean                @default(true)
  updatedAt             DateTime               @default(now()) @updatedAt
  departmentId          String?
  tenantId              String
  department            Department?            @relation(fields: [departmentId], references: [id])
  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  permissionGroupItems  PermissionGroupItem[]
  permissionOverrides   PermissionOverride[]
  roleModulePermissions RoleModulePermission[]
  documents             Document[]
  formSubmissions       FormSubmission[]

  @@unique([tenantId, key])
  @@unique([tenantId, path])
  @@index([tenantId])
  @@index([tenantId, departmentId])
  @@index([tenantId, type])
  @@index([tenantId, departmentId, order])
  @@map("modules")
}

model RoleModulePermission {
  id           String     @id @default(uuid())
  tenantId     String
  roleId       String
  moduleId     String
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module       Module     @relation(fields: [moduleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([tenantId, roleId, moduleId, permissionId])
  @@index([tenantId, roleId])
  @@map("role_module_permissions")
}

model Team {
  id           String       @id @default(uuid())
  name         String
  description  String?
  departmentId String
  leadUserId   String?
  tenantId     String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  members      TeamMember[]
  department   Department   @relation(fields: [departmentId], references: [id])
  lead         User?        @relation("TeamLead", fields: [leadUserId], references: [id])
  tenant       Tenant       @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([departmentId])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String
  userId   String
  tenantId String
  role     String   @default("Member")
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("team_members")
}

model PermissionOverride {
  id           String           @id @default(uuid())
  userId       String
  moduleId     String
  permissionId Int
  effect       PermissionEffect
  tenantId     String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  module       Module           @relation(fields: [moduleId], references: [id])
  permission   Permission       @relation(fields: [permissionId], references: [id])
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  user         User             @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId, moduleId, permissionId])
  @@index([tenantId])
  @@map("permission_overrides")
}

model PermissionGroup {
  id          String                      @id @default(uuid())
  name        String
  description String?
  tenantId    String
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  assignments PermissionGroupAssignment[]
  items       PermissionGroupItem[]
  tenant      Tenant                      @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("permission_groups")
}

model PermissionGroupItem {
  id           String          @id @default(uuid())
  tenantId     String
  groupId      String
  moduleId     String
  permissionId Int
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  group        PermissionGroup @relation(fields: [groupId], references: [id])
  module       Module          @relation(fields: [moduleId], references: [id])
  permission   Permission      @relation(fields: [permissionId], references: [id])

  @@unique([tenantId, groupId, moduleId, permissionId])
  @@map("permission_group_items")
}

model PermissionGroupAssignment {
  id           String          @id @default(uuid())
  tenantId     String
  groupId      String
  userId       String?
  departmentId String?
  assignedAt   DateTime        @default(now())
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  department   Department?     @relation(fields: [departmentId], references: [id])
  group        PermissionGroup @relation(fields: [groupId], references: [id])
  user         User?           @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([groupId])
  @@index([userId])
  @@index([departmentId])
  @@map("permission_group_assignments")
}

model Role {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  slug          String
  description   String?
  rank          Int           @default(100)
  isSystem      Boolean       @default(false)
  isTenantAdmin Boolean       @default(false)
  dataScope     RoleDataScope @default(SELF)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  users                 User[]
  roleModulePermissions RoleModulePermission[]
  invitations           Invitation[]

  @@unique([tenantId, slug])
  @@index([tenantId, rank])
  @@map("roles")
}

model Invitation {
  id               String           @id @default(uuid())
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email            String
  tokenHash        String           @unique
  status           InvitationStatus @default(PENDING)
  roleId           String
  role             Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  departmentId     String?
  department       Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  invitedByUserId  String
  invitedBy        User             @relation("InvitationsSent", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedByUserId String?
  acceptedBy       User?            @relation("InvitationsAccepted", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  lastSentAt       DateTime         @default(now())
  sendCount        Int              @default(1)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([tenantId, email])
  @@index([tenantId, status])
  @@map("invitations")
}

model SystemAdmin {
  id          String          @id @default(uuid())
  email       String          @unique
  password    String
  name        String
  role        SystemAdminRole @default(SUPER_ADMIN)
  isActive    Boolean         @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  lifecycleEvents TenantLifecycleEvent[]

  @@map("system_admins")
}

model TenantLifecycleEvent {
  id                 String       @id @default(uuid())
  tenantId           String
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorSystemAdminId String
  actor              SystemAdmin  @relation(fields: [actorSystemAdminId], references: [id], onDelete: Restrict)
  fromStatus         TenantStatus
  toStatus           TenantStatus
  reason             String?
  metadata           Json?
  createdAt          DateTime     @default(now())

  @@index([tenantId, createdAt])
  @@map("tenant_lifecycle_events")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
}

enum RoleDataScope {
  TENANT
  DEPARTMENT
  TEAM
  SELF
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum SystemAdminRole {
  SUPER_ADMIN
}

enum EmploymentStatus {
  ACTIVE
  SUSPENDED
  ON_LEAVE
  FIRED
}

enum DealStatus {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PermissionType {
  VIEW
  CREATE
  EDIT
  DELETE
}

enum PermissionEffect {
  GRANT
  REVOKE
}

enum ModuleType {
  DASHBOARD_VIEW
  DATA_TABLE
  KANBAN_BOARD
  DOCUMENT_HUB
  FORM_BUILDER
}

enum DocumentFormat {
  MARKDOWN
  RICH_TEXT
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
