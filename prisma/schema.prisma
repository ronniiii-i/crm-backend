generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                  String               @id @default(uuid())
  name                String
  slug                String               @unique
  status              String               @default("ACTIVE")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  attendanceRecords   AttendanceRecord[]
  contacts            Contact[]
  deals               Deal[]
  departments         Department[]
  expenses            Expense[]
  inventoryItems      InventoryItem[]
  invoices            Invoice[]
  notifications       Notification[]
  payments            Payment[]
  projects            Project[]
  projectFiles        ProjectFile[]
  projectMembers      ProjectMember[]
  quickActions        QuickAction[]
  supportTickets      SupportTicket[]
  tasks               Task[]
  blacklistedTokens   BlacklistedToken[]
  modules             Module[]
  permissionGroups    PermissionGroup[]
  permissionOverrides PermissionOverride[]
  teamMembers         TeamMember[]
  teams               Team[]
  users               User[]

  @@map("tenants")
}

model User {
  id                         String                      @id @default(uuid())
  email                      String
  password                   String
  name                       String
  role                       Role                        @default(STAFF)
  avatarUrl                  String?
  lastLoginAt                DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  isVerified                 Boolean                     @default(false)
  verifyToken                String?
  verifyExpires              DateTime?
  resetToken                 String?
  resetExpires               DateTime?
  departmentId               String?                     @map("department")
  status                     EmploymentStatus            @default(ACTIVE)
  tenantId                   String
  attendanceRecords          AttendanceRecord[]
  contacts                   Contact[]
  assignedDeals              Deal[]                      @relation("DealAssignedTo")
  managedDepartment          Department?                 @relation("DepartmentManager")
  expenses                   Expense[]
  notifications              Notification[]
  projects                   Project[]
  uploadedFiles              ProjectFile[]
  projectMemberships         ProjectMember[]
  assignedTickets            SupportTicket[]             @relation("UserTickets")
  tasks                      Task[]
  blacklistedTokens          BlacklistedToken[]
  permissionGroupAssignments PermissionGroupAssignment[]
  permissionOverrides        PermissionOverride[]
  teamMemberships            TeamMember[]
  ledTeams                   Team[]                      @relation("TeamLead")
  department                 Department?                 @relation("DepartmentMembers", fields: [departmentId], references: [id])
  tenant                     Tenant                      @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Contact {
  id             String          @id @default(uuid())
  firstName      String
  lastName       String
  email          String?
  phone          String?
  company        String?
  jobTitle       String?
  notes          String?
  status         String          @default("Lead")
  userId         String
  tenantId       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tags           String[]
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  createdBy      User            @relation(fields: [userId], references: [id])
  deals          Deal[]
  invoices       Invoice[]
  supportTickets SupportTicket[]

  @@index([tenantId])
}

model Project {
  id          String          @id @default(uuid())
  name        String
  description String?
  status      String          @default("Planning")
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  priority    Int             @default(1)
  userId      String
  tenantId    String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  createdBy   User            @relation(fields: [userId], references: [id])
  files       ProjectFile[]
  teamMembers ProjectMember[]
  tasks       Task[]

  @@index([tenantId])
}

model Task {
  id           String    @id @default(uuid())
  title        String
  description  String?
  status       String    @default("Todo")
  priority     Int       @default(1)
  dueDate      DateTime?
  projectId    String
  assignedToId String
  tenantId     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  assignedTo   User      @relation(fields: [assignedToId], references: [id])
  project      Project   @relation(fields: [projectId], references: [id])
  tenant       Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Department {
  id                         String                      @id @default(uuid())
  name                       String
  description                String?
  type                       DepartmentType
  managerId                  String?                     @unique
  tenantId                   String
  createdAt                  DateTime                    @default(now())
  manager                    User?                       @relation("DepartmentManager", fields: [managerId], references: [id])
  tenant                     Tenant                      @relation(fields: [tenantId], references: [id])
  expenses                   Expense[]
  Module                     Module[]
  permissionGroupAssignments PermissionGroupAssignment[]
  teams                      Team[]
  members                    User[]                      @relation("DepartmentMembers")

  @@unique([tenantId, type])
  @@index([tenantId])
}

model InventoryItem {
  id          String   @id @default(uuid())
  name        String
  description String?
  sku         String?
  quantity    Int      @default(0)
  unit        String   @default("pcs")
  minStock    Int      @default(5)
  location    String?
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, sku])
  @@index([tenantId])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  read      Boolean  @default(false)
  type      String
  userId    String
  tenantId  String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
}

model ProjectFile {
  id         String   @id @default(uuid())
  name       String
  url        String
  size       Int
  type       String
  projectId  String
  userId     String
  tenantId   String
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id])
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  uploadedBy User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   @default("Member")
  tenantId  String
  joinedAt  DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
}

model BlacklistedToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  tenantId  String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tenantId])
  @@map("blacklisted_tokens")
}

model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String
  customerId    String
  amount        Float
  status        String    @default("Pending")
  dueDate       DateTime
  paidDate      DateTime?
  tenantId      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  customer      Contact   @relation(fields: [customerId], references: [id])
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  payments      Payment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
}

model Payment {
  id        String   @id @default(uuid())
  invoiceId String
  amount    Float
  paidAt    DateTime @default(now())
  method    String
  tenantId  String
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Expense {
  id           String     @id @default(uuid())
  description  String
  amount       Float
  category     String
  incurredAt   DateTime
  departmentId String
  userId       String
  tenantId     String
  createdAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id])
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  createdBy    User       @relation(fields: [userId], references: [id])

  @@index([tenantId])
}

model Deal {
  id         String     @id @default(uuid())
  name       String
  contactId  String
  amount     Float
  status     DealStatus @default(LEAD)
  closeDate  DateTime?
  userId     String
  tenantId   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  contact    Contact    @relation(fields: [contactId], references: [id])
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  assignedTo User       @relation("DealAssignedTo", fields: [userId], references: [id])

  @@index([tenantId])
}

model SupportTicket {
  id             String       @id @default(uuid())
  subject        String
  description    String?
  status         TicketStatus @default(OPEN)
  priority       Int          @default(1)
  contactId      String
  userId         String?
  tenantId       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  resolvedAt     DateTime?
  slaDueDate     DateTime?
  customerRating Int?
  createdBy      Contact      @relation(fields: [contactId], references: [id])
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  assignedTo     User?        @relation("UserTickets", fields: [userId], references: [id])

  @@index([tenantId])
}

model AttendanceRecord {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime
  status    String
  tenantId  String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
}

model QuickAction {
  id          String   @id @default(uuid())
  name        String
  description String?
  command     String
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Permission {
  id                    Int                    @id @default(autoincrement())
  type                  PermissionType         @unique
  permissionGroupItems  PermissionGroupItem[]
  permissionOverrides   PermissionOverride[]
  roleModulePermissions RoleModulePermission[]

  @@map("permissions")
}

model Module {
  id                    String                 @id @default(uuid())
  name                  String
  path                  String
  icon                  String?
  departmentId          String?
  tenantId              String?
  department            Department?            @relation(fields: [departmentId], references: [id])
  tenant                Tenant?                @relation(fields: [tenantId], references: [id])
  permissionGroupItems  PermissionGroupItem[]
  permissionOverrides   PermissionOverride[]
  roleModulePermissions RoleModulePermission[]

  @@unique([tenantId, path])
  @@index([tenantId])
  @@map("modules")
}

model RoleModulePermission {
  id           String     @id @default(uuid())
  role         Role
  moduleId     String
  permissionId Int
  module       Module     @relation(fields: [moduleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([role, moduleId, permissionId])
  @@map("role_module_permissions")
}

model Team {
  id           String       @id @default(uuid())
  name         String
  description  String?
  departmentId String
  leadUserId   String?
  tenantId     String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  members      TeamMember[]
  department   Department   @relation(fields: [departmentId], references: [id])
  lead         User?        @relation("TeamLead", fields: [leadUserId], references: [id])
  tenant       Tenant       @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([departmentId])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String
  userId   String
  tenantId String
  role     String   @default("Member")
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("team_members")
}

model PermissionOverride {
  id           String           @id @default(uuid())
  userId       String
  moduleId     String
  permissionId Int
  effect       PermissionEffect
  tenantId     String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  module       Module           @relation(fields: [moduleId], references: [id])
  permission   Permission       @relation(fields: [permissionId], references: [id])
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  user         User             @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId, moduleId, permissionId])
  @@index([tenantId])
  @@map("permission_overrides")
}

model PermissionGroup {
  id          String                      @id @default(uuid())
  name        String
  description String?
  tenantId    String
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  assignments PermissionGroupAssignment[]
  items       PermissionGroupItem[]
  tenant      Tenant                      @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("permission_groups")
}

model PermissionGroupItem {
  id           String          @id @default(uuid())
  groupId      String
  moduleId     String
  permissionId Int
  group        PermissionGroup @relation(fields: [groupId], references: [id])
  module       Module          @relation(fields: [moduleId], references: [id])
  permission   Permission      @relation(fields: [permissionId], references: [id])

  @@unique([groupId, moduleId, permissionId])
  @@map("permission_group_items")
}

model PermissionGroupAssignment {
  id           String          @id @default(uuid())
  groupId      String
  userId       String?
  departmentId String?
  assignedAt   DateTime        @default(now())
  department   Department?     @relation(fields: [departmentId], references: [id])
  group        PermissionGroup @relation(fields: [groupId], references: [id])
  user         User?           @relation(fields: [userId], references: [id])

  @@index([groupId])
  @@index([userId])
  @@index([departmentId])
  @@map("permission_group_assignments")
}

enum Role {
  ADMIN
  HOD
  LEAD
  STAFF
}

enum DepartmentType {
  ADMINISTRATION
  HUMAN_RESOURCES
  SALES
  OPERATIONS
  FINANCE
  INFORMATION_TECHNOLOGY
  CUSTOMER_SERVICE
  ACCOUNTING
}

enum EmploymentStatus {
  ACTIVE
  SUSPENDED
  ON_LEAVE
  FIRED
}

enum DealStatus {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PermissionType {
  VIEW
  CREATE
  EDIT
  DELETE
}

enum PermissionEffect {
  GRANT
  REVOKE
}
