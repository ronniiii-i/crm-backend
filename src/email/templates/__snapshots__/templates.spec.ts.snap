exports[`email templates renders a contact request with a mailto reply action 1`] = `
{
  "html": "<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>New contact request</title>
  </head>
  <body style="margin:0;padding:0;background-color:#f1f5f9;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#0f172a;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;">Ada Lovelace sent a message through the contact form.</div>
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color:#f1f5f9;">
      <tr>
        <td align="center" style="padding:32px 12px;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:560px;background-color:#ffffff;border-radius:12px;border:1px solid #e2e8f0;">
            <tr>
              <td style="padding:24px 32px 8px 32px;font-size:13px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#2563eb;">Clasp Workspace</td>
            </tr>
            <tr>
              <td style="padding:8px 32px 24px 32px;">
                <h1 style="margin:0 0 16px 0;font-size:22px;line-height:1.3;font-weight:700;color:#0f172a;">New contact request</h1>
                
                <p style="margin:0 0 14px 0;font-size:15px;line-height:1.6;">A message was submitted through the contact form.</p><p style="margin:0 0 14px 0;font-size:15px;line-height:1.6;">Please call me.</p>
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:18px 0;padding:12px 16px;background-color:#f8fafc;border-radius:8px;border:1px solid #e2e8f0;"><tr><td style="padding:4px 12px 4px 0;color:#64748b;font-size:14px;vertical-align:top;">Name</td><td style="padding:4px 0;color:#0f172a;font-size:14px;vertical-align:top;">Ada Lovelace</td></tr><tr><td style="padding:4px 12px 4px 0;color:#64748b;font-size:14px;vertical-align:top;">Email</td><td style="padding:4px 0;color:#0f172a;font-size:14px;vertical-align:top;">ada@example.com</td></tr><tr><td style="padding:4px 12px 4px 0;color:#64748b;font-size:14px;vertical-align:top;">Company</td><td style="padding:4px 0;color:#0f172a;font-size:14px;vertical-align:top;">Analytical Engines</td></tr><tr><td style="padding:4px 12px 4px 0;color:#64748b;font-size:14px;vertical-align:top;">Topic</td><td style="padding:4px 0;color:#0f172a;font-size:14px;vertical-align:top;">Billing</td></tr></table>
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:24px 0 8px 0;"><tr><td style="border-radius:8px;background-color:#2563eb;"><a href="mailto:ada@example.com" style="display:inline-block;padding:12px 22px;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:8px;">Reply by email</a></td></tr></table>
                <p style="margin:20px 0 0 0;font-size:13px;line-height:1.5;color:#64748b;">Reply directly to this email to respond to the sender.</p>
              </td>
            </tr>
            <tr>
              <td style="padding:16px 32px 24px 32px;border-top:1px solid #e2e8f0;color:#64748b;font-size:12px;line-height:1.6;">
                
                <div>Clasp Workspace &middot; Need help? <a href="mailto:support@claspworkspace.com" style="color:#2563eb;text-decoration:none;">support@claspworkspace.com</a></div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>",
  "subject": "Contact request: Billing",
  "text": "New contact request

A message was submitted through the contact form.

Please call me.

Name: Ada Lovelace
Email: ada@example.com
Company: Analytical Engines
Topic: Billing

Reply by email: mailto:ada@example.com

Reply directly to this email to respond to the sender.

Clasp Workspace
Support: support@claspworkspace.com",
}
`;

exports[`email templates renders a leave decision with an optional note 1`] = `
{
  "html": "<!doctype html>
