                <div style="margin-bottom:4px;color:#475569;font-weight:600;">Acme</div>
                <div>Clasp Workspace &middot; Need help? <a href="mailto:support@claspworkspace.com" style="color:#2563eb;text-decoration:none;">support@claspworkspace.com</a></div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
