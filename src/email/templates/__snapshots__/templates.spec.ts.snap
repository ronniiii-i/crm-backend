    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color:#f1f5f9;">
      <tr>
        <td align="center" style="padding:32px 12px;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:560px;background-color:#ffffff;border-radius:12px;border:1px solid #e2e8f0;">
            <tr>
              <td style="padding:24px 32px 8px 32px;font-size:13px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#2563eb;">Clasp Workspace</td>
            </tr>
            <tr>
              <td style="padding:8px 32px 24px 32px;">
                <h1 style="margin:0 0 16px 0;font-size:22px;line-height:1.3;font-weight:700;color:#0f172a;">Your password was changed</h1>
                <p style="margin:0 0 14px 0;font-size:15px;line-height:1.6;">Hi Grace Hopper,</p>
                <p style="margin:0 0 14px 0;font-size:15px;line-height:1.6;">The password for your Acme account was just changed.</p><p style="margin:0 0 14px 0;font-size:15px;line-height:1.6;">For your security, every other active session has been signed out.</p>
                
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:24px 0 8px 0;"><tr><td style="border-radius:8px;background-color:#2563eb;"><a href="https://app.example.com/acme/login" style="display:inline-block;padding:12px 22px;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:8px;">Sign in</a></td></tr></table>
                <p style="margin:20px 0 0 0;font-size:13px;line-height:1.5;color:#64748b;">If you did not make this change, contact your workspace administrator immediately.</p>
              </td>
