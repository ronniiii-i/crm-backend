# ---------------------------------------------------------------------------
# ClaspCRM backend environment
# Copy to `.env` and fill in real values. 
# The application validates this file at boot (src/config/env.validation.ts)
# and refuses to start when a required value is missing or unsafe.
# ---------------------------------------------------------------------------

# Application runtime database connection.
DATABASE_URL="postgresql://crm_app:REPLACE_ME@HOST/DBNAME?sslmode=require"
# Owner/direct connection: migrations and seeding only. Never expose at runtime.
DIRECT_URL="postgresql://OWNER:REPLACE_ME@HOST/DBNAME?sslmode=require"
# Isolated system-admin connection. This role has no tenant-table grants.
SYSTEM_DATABASE_URL="postgresql://crm_system:REPLACE_ME@HOST/DBNAME?sslmode=require"

# Runtime mode: development | test | production
NODE_ENV="development"

PORT="3030"

# JWT signing secret.
# Generate one with:  openssl rand -base64 48
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Access-token lifetime (e.g. 1h, 30m, 15m)
JWT_EXPIRES_IN="1h"

# Shared cache (Redis). The cache is shared across app instances, so a local
# in-process store is NOT sufficient. All keys are prefixed with
# `tenant:{tenantId}:` so tenants never share entries.
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
# Use TLS (rediss://) for managed providers such as Upstash / Redis Cloud.
REDIS_TLS="false"
# Database index and key prefix (lets several apps share one Redis instance).
REDIS_DB="0"
REDIS_KEY_PREFIX="claspcrm"
# Milliseconds to wait for the initial connection before continuing without cache.
REDIS_CONNECT_TIMEOUT="3000"
# If Redis is unreachable, fall back to a bounded in-process cache (entries are
# capped at 60s). Set to "false" in a multi-instance deployment that must never
# serve an entry another instance could not invalidate.
REDIS_FALLBACK_MEMORY="true"

# Frontend origin allowed by CORS
FRONTEND_URL="http://localhost:3000"

# SMTP (verification / reset emails)
MAIL_HOST=""
MAIL_PORT=""
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM=""

# Google reCAPTCHA
RECAPTCHA_SECRET=""

# ---------------------------------------------------------------------------
# Seeding and workspace provisioning (seed-only / onboarding)
# ---------------------------------------------------------------------------

# Isolated system administrator created by `npm run db:seed`.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_NAME="System Admin"

# Provision lean `acme` and `beta` demo tenants when running `npm run db:seed`.
SEED_DEMO="false"

# New workspace trial length (days). Defaults to 14 if unset.
WORKSPACE_TRIAL_DAYS="14"
# Grace period after expiry before suspension (days).
WORKSPACE_GRACE_DAYS="7"
# When true, newly created workspaces are auto-verified (not recommended).
AUTO_VERIFY_WORKSPACE="false"
