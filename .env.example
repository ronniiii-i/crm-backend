# ---------------------------------------------------------------------------
# ClaspCRM backend environment
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# The application validates this file at boot (src/config/env.validation.ts)
# and refuses to start when a required value is missing or unsafe.
# ---------------------------------------------------------------------------

# Application runtime database connection.
# IMPORTANT: this MUST use the non-owner application role (crm_app) so that
# Postgres Row Level Security is enforced. The owner role has BYPASSRLS and
# would silently bypass every tenant policy.
DATABASE_URL="postgresql://crm_app:REPLACE_ME@HOST/DBNAME?sslmode=require"

# Migration / admin connection used only by the Prisma CLI (migrate, db push,
# db seed). Uses the database owner role.
DIRECT_URL="postgresql://OWNER:REPLACE_ME@HOST/DBNAME?sslmode=require"

# Runtime mode: development | test | production
NODE_ENV="development"

# HTTP port the API listens on
PORT="3030"

# JWT signing secret.
# MUST be at least 16 characters and MUST NOT be a placeholder value — the
# boot-time validation rejects known placeholders such as "supersecret".
# Generate one with:  openssl rand -base64 48
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Access-token lifetime (e.g. 1h, 30m, 15m)
JWT_EXPIRES_IN="1h"

# Dashboard cache (Redis)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Frontend origin allowed by CORS
FRONTEND_URL="http://localhost:3000"

# SMTP (verification / reset emails)
MAIL_HOST=""
MAIL_PORT=""
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM=""

# Google reCAPTCHA
RECAPTCHA_SECRET=""
