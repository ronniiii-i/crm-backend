# ---------------------------------------------------------------------------
# Clasp Workspace backend environment
# Copy to `.env` and fill in real values. 
# The application validates this file at boot (src/config/env.validation.ts)
# and refuses to start when a required value is missing or unsafe.
# ---------------------------------------------------------------------------

# Application runtime database connection.
DATABASE_URL="postgresql://crm_app:REPLACE_ME@HOST/DBNAME?sslmode=require"
# Owner/direct connection: migrations and seeding only. Never expose at runtime.
DIRECT_URL="postgresql://OWNER:REPLACE_ME@HOST/DBNAME?sslmode=require"
# Isolated system-admin connection. This role has no tenant-table grants.
SYSTEM_DATABASE_URL="postgresql://crm_system:REPLACE_ME@HOST/DBNAME?sslmode=require"

# Runtime mode: development | test | production
NODE_ENV="development"

PORT="3030"

# JWT signing secret for tenant tokens.
# Generate one with:  openssl rand -base64 48
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# System admin JWT signing secret (must differ from JWT_SECRET).
# Generate one with:  openssl rand -base64 48
SYSTEM_JWT_SECRET="REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET"

# Access-token lifetime (e.g. 1h, 30m, 15m)
JWT_EXPIRES_IN="1h"

# Product name used in email senders, subjects, and templates.
APP_NAME="Clasp Workspace"
# Fallback workspace name when a workspace is provisioned without one.
DEFAULT_TENANT_NAME="Default Workspace"

# Frontend URL construction
FRONTEND_PROTOCOL="http"
# Development keeps localhost:3000; production uses claspworkspace.com.
FRONTEND_ROOT_DOMAIN="localhost:3000"
SUPPORT_EMAIL="support@claspworkspace.com"
CONTACT_INBOX="hello@claspworkspace.com"

# Shared cache (Redis). The cache is shared across app instances, so a local
# in-process store is NOT sufficient. All keys are prefixed with
# `tenant:{tenantId}:` so tenants never share entries.
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
# Use TLS (rediss://) for managed providers such as Upstash / Redis Cloud.
REDIS_TLS="false"
# Database index and key prefix (lets several apps share one Redis instance).
REDIS_DB="0"
REDIS_KEY_PREFIX="claspworkspace"
# Milliseconds to wait for the initial connection before continuing without cache.
REDIS_CONNECT_TIMEOUT="3000"
# If Redis is unreachable, fall back to a bounded in-process cache (entries are
# capped at 60s). Set to "false" in a multi-instance deployment that must never
# serve an entry another instance could not invalidate.
REDIS_FALLBACK_MEMORY="true"

# Frontend origin allowed by CORS
FRONTEND_URL="http://localhost:3000"

# SMTP (verification / reset emails)
# DEPRECATED in Phase 4: replaced by Resend (see the EMAIL_* block below).
# Kept temporarily so Phase 4 Stage 1/2 can boot before the Stage 3 cut-over.
MAIL_HOST=""
MAIL_PORT=""
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM=""

# ---------------------------------------------------------------------------
# Phase 4 platform configuration
# ---------------------------------------------------------------------------

# Trust the first proxy hop for client IP resolution (rate limiting).
# Set to the number of reverse proxies in front of the API, or "false".
TRUST_PROXY="1"

# Rate limiting (sliding window). Enforcement defaults to off in test.
RATE_LIMIT_ENFORCE="true"
RATE_LIMIT_AUTH_PER_MIN="15"
RATE_LIMIT_API_PER_MIN="600"
RATE_LIMIT_WRITE_PER_MIN="120"
RATE_LIMIT_EXPORT_PER_HOUR="10"

# Persistent session lifetime (hours). Default 7 days.
AUTH_SESSION_TTL_HOURS="168"

# Email provider (Resend). EMAIL_ENABLED=false renders to the log only.
EMAIL_ENABLED="true"
RESEND_API_KEY=""
EMAIL_FROM="Clasp Workspace <notifications@claspworkspace.com>"
EMAIL_REPLY_TO=""
# Redirect every outbound email here outside production (staging safety).
EMAIL_OVERRIDE_TO=""
# Absolute application origin used in links (no trailing slash).
APP_URL="http://localhost:3000"

# Object storage: "local" (development) or "r2" (production).
STORAGE_DRIVER="local"
STORAGE_MAX_AVATAR_BYTES="5242880"
STORAGE_MAX_ATTACHMENT_BYTES="26214400"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""
R2_ENDPOINT=""

# Real-time notifications.
SSE_ENABLED="true"

# Soft deletes. Set to "false" only as an emergency rollback lever.
SOFT_DELETE_ENFORCE="true"
SOFT_DELETE_RETENTION_DAYS="90"

# CSV export hard cap.
EXPORT_MAX_ROWS="100000"

# Google reCAPTCHA
RECAPTCHA_SECRET=""

# ---------------------------------------------------------------------------
# Seeding and workspace provisioning (seed-only / onboarding)
# ---------------------------------------------------------------------------

# Isolated system administrator created by `npm run db:seed`.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_NAME="System Admin"

# Provision lean `acme` and `beta` demo tenants when running `npm run db:seed`.
SEED_DEMO="false"

# New workspace trial length (days). Defaults to 14 if unset.
WORKSPACE_TRIAL_DAYS="14"
# Grace period after expiry before suspension (days).
WORKSPACE_GRACE_DAYS="7"
# When true, newly created workspaces are auto-verified (not recommended).
AUTO_VERIFY_WORKSPACE="false"
